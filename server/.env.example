# Port the API listens on.
#
# Locally this is 4000 (the Next dev server uses 3000). Render injects PORT
# itself and the app uses whatever value it is given; 3000 is only the fallback.
PORT=4000

# Browser origins allowed to call the API with cookies, comma separated.
#
# Must be the exact origin of the deployed client - scheme and host, no path, no
# trailing slash. An entry like *.vercel.app additionally allows any subdomain
# of that host, which is what makes Vercel preview deployments work.
# Local example:            http://localhost:3000
# Production example:       https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# MongoDB connection string. Atlas SRV string, credentials included.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/image-gallery

# Cloudinary credentials in the format cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://123456789012345:your-api-secret@your-cloud-name

# Folder uploads are stored in inside the Cloudinary account. Optional.
CLOUDINARY_FOLDER=image-gallery

# The one account allowed into /admin. Change the password before deploying.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Secret used to sign the session JWT. Use a long random string
# (e.g. `openssl rand -hex 32`) and never reuse a value from another project.
JWT_SECRET=change-me

# How long a session stays valid.
JWT_EXPIRES_IN=7d

# Session cookie policy. Leave unset: it defaults to "none" in production,
# which is required because the client and the API are on different sites, and
# to "lax" in development. Override only if a deployment needs something else.
# COOKIE_SAME_SITE=none
